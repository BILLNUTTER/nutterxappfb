{
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",

    "module": "ESNext",
    "target": "ES2020",

    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  }
}
